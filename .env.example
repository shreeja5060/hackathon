# Copy this file to .env and fill in real values. Never commit .env itself.

# How the agents reach Claude: "anthropic" (direct, needs ANTHROPIC_API_KEY)
# or "vertex" (Claude on Google Cloud Vertex AI, billed to the GCP project,
# no Anthropic key needed). Vertex is the intended route, but the project quota for Claude is 0 until the organizers raise it; use anthropic with your own key until then.
CLAUDE_BACKEND=anthropic

# --- vertex backend ---
ANTHROPIC_VERTEX_PROJECT_ID=uc2-cyber-policy-compliance
CLOUD_ML_REGION=global
# CLAUDE_MODEL=claude-sonnet-4-5@20250929     # default; override only if needed

# --- anthropic backend (only if CLAUDE_BACKEND=anthropic) ---
ANTHROPIC_API_KEY=your_key_here

# Optional
GOOGLE_CLOUD_PROJECT=uc2-cyber-policy-compliance
