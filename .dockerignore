# Secrets: the API key comes from Secret Manager at runtime, never the image.
.env
*.key

# Local environments and caches
venv/
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.vscode/
.idea/

# Generated locally; the image builds its own index.
chroma_db/
data/processed/
data/frameworks/*.json
*.sqlite3
*.db
*.log

.git/

# Local review records: the image starts with an empty ledger (or restores it from
# Cloud Storage, see deploy/README.md), never with a developer's test data.
data/ledger*.sqlite3*
data/.ledger*
data/documents*/
