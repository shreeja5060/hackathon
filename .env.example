# Copy this file to .env and fill in real values. Never commit .env itself.

ANTHROPIC_API_KEY=your_key_here

# Q&A agent model (defaults to claude-haiku-4-5; e.g. claude-sonnet-5-5 for the demo)
# CHAT_MODEL=claude-haiku-4-5

# Dashboard: live data, with the Q&A agent plugged into the chat
# COPILOT_BACKEND=live
# COPILOT_QA_MODULE=qa_agent.agent:ask

# Optional, depending on what Phase 1/3 end up using
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
